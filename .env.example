APP_ENV=local
API_BIND=0.0.0.0:8080
APP_ORIGIN=http://localhost:5173
WS_ORIGIN_ALLOWLIST=http://localhost:5173
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECS=5
DB_CONNECT_TIMEOUT_SECS=10
# true por padrão apenas em local/CI; staging/produção devem executar uma vez por release.
RUN_MIGRATIONS=true
# Primeiro item ativo; mantenha chaves antigas apenas durante a janela de rotação.
# Substitua este valor local. Staging/produção recusam chave ausente, curta ou placeholder.
TOKEN_FINGERPRINT_KEYS=local-v1:change-this-local-key-32-bytes-minimum
# __Host- exige Secure inclusive no desenvolvimento; staging/produção recusam false.
COOKIE_SECURE=true
SESSION_IDLE_TTL=30m
SESSION_ABSOLUTE_TTL=720h
CSRF_TTL=30m
# last_seen_at é atualizado no máximo uma vez por este intervalo.
SESSION_TOUCH_INTERVAL=5m
QR_CHALLENGE_TTL=90s
QR_APPROVAL_TTL=90s
QR_CONTINUATION_TTL=5m
RATE_LIMIT_BACKEND=memory
AUDIT_RETENTION_DAYS=90
RAW_IP_RETENTION_DAYS=30
