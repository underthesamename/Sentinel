localhost {
  encode zstd gzip

  handle /v1/* {
    reverse_proxy api:8080
  }

  handle /health/* {
    reverse_proxy api:8080
  }

  handle {
    reverse_proxy web:5173
  }

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Content-Security-Policy "default-src 'self'; connect-src 'self' wss:; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}

